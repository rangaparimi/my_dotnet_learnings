@model LinksViewModel
@{
    ViewData["Title"] = "Links";
}

<h1>Reverse routing</h1>
<p>These links were NOT typed as strings in the view or the controller. Each was generated by
<code>Url.Action(actionName, routeValues)</code> from the route table, the same problem Flask's
<code>url_for()</code> solves.</p>

<ul>
    <li><a href="@Model.LinkToBook42">@Model.LinkToBook42</a> (generated for BookById with id=42)</li>
    <li><a href="@Model.LinkToPing">@Model.LinkToPing</a> (generated for Ping)</li>
    <li><a href="@Model.LinkToHomeIndex">@Model.LinkToHomeIndex</a> (generated for Home/Index)</li>
</ul>

<a asp-controller="RoutingDemo" asp-action="Index">&larr; back to routing demo</a>
